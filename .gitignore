# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# backups (dumps SQL locaux — scripts/dump_sandbox.sh, jamais versionnés)
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts

# corbeille de session (les outils du pont ne peuvent pas supprimer, ils déplacent ici)
/_to_delete/

# Registre local du décor de recette C4-L6 (scripts/recette/decor-c4l6.mjs)
.decor-c4l6.json

# Registre local du décor de recette C4-L7 (scripts/recette/traversee-c4l7.mjs)
scripts/recette/.traversee-c4l7-registre.json

# Registre local du décor de recette C4-L2 (scripts/recette/routeur-c4l2-decor.mjs).
# Posé par C4-L13 : le retrait du décor d'assiduité ne se fait plus par signature
# de minutes — 45-60 min est un budget RÉEL — mais par les couples qu'il nomme.
scripts/recette/.routeur-c4l2-decor-registre.json
