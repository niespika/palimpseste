# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# backups (dumps SQL locaux — scripts/dump_sandbox.sh, jamais versionnés)
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts

# corbeille de session (les outils du pont ne peuvent pas supprimer, ils déplacent ici)
/_to_delete/

# Registre local du décor de recette C4-L6 (scripts/recette/decor-c4l6.mjs)
.decor-c4l6.json

# Registre local du décor de recette C4-L7 (scripts/recette/traversee-c4l7.mjs)
scripts/recette/.traversee-c4l7-registre.json

# Registre local du décor de recette C4-L2 (scripts/recette/routeur-c4l2-decor.mjs).
# Posé par C4-L13 : le retrait du décor d'assiduité ne se fait plus par signature
# de minutes — 45-60 min est un budget RÉEL — mais par les couples qu'il nomme.
scripts/recette/.routeur-c4l2-decor-registre.json

# Registre local du décor d'écran d'Élo (scripts/recette/decor-eleve-elo.mjs).
# Il porte l'ÉTAT D'AVANT des deux examens diagnostiques et des six lignes de
# niveau — la seule chose que la marque en base ne sait pas reconstituer. C'est
# un état de machine, pas une source : il ne se partage pas.
scripts/recette/.decor-eleve-elo.json

# Registres de la réparation C4L12-25 (scripts/recette/reparation-etats-c4l12-24.mjs)
# ⭐ L'état AVANT écriture, horodaté, une copie par passage. Il reste LOCAL : il
#    porte des identifiants d'élèves réels, et un registre n'est pas une source.
scripts/recette/.reparation-c4l12-25-*.json

# Registre local du décor de l'épreuve C4L12-25
# (scripts/recette/epreuve-reparation-c4l12-25.mjs). ⛔ Il porte l'état AVANT
#    d'un élève réel du bac à sable : c'est lui qui rend la base, et il meurt
#    avec le `--retire` réussi.
scripts/recette/.epreuve-reparation-c4l12-25.json
